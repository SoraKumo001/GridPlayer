<UserControl x:Class="GridPlayer.VolumeController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:GridPlayer="clr-namespace:GridPlayer" 
             d:DataContext="{d:DesignInstance Type=GridPlayer:AppStatus}"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="800">

    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0">
            <Button x:Name="volumeOn" Click="volumeOn_Click" Visibility="{Binding IsMute, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{x:Null}" Background="Transparent" BorderThickness="0">
                <Image Source="/Images/outline_volume_up_white_48dp.png" Opacity="0.8"/>
            </Button>
            <Button x:Name="volumeOff" Click="volumeOff_Click" Visibility="{Binding IsMute, Converter={StaticResource ReverseBooleanToVisibilityConverter}}" Style="{x:Null}" Background="Transparent" BorderThickness="0">
                <Image Source="/Images/outline_volume_off_white_48dp.png" Opacity="0.8"/>
            </Button>
        </Grid>

        <Slider x:Name="volumeSlider" Grid.Column="1" Margin="8,0" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.01" VerticalAlignment="Center" MinWidth="100">
            <Slider.ToolTip>
                <ToolTip Content="{Binding Volume, StringFormat={}{0:P0}}"/>
            </Slider.ToolTip>
        </Slider>
        
        <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}" Grid.Column="2" Foreground="#888888" FontSize="10" VerticalAlignment="Center" Width="30" TextAlignment="Right" Margin="0,0,5,0"/>
    </Grid>
</UserControl>
