<Window x:Class="GridPlayer.MediaListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GridPlayer"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Media Library" Height="500" Width="900" Loaded="Window_Loaded" MouseDown="Window_MouseDown" 
        Background="#1A1A1A" Foreground="#E0E0E0">
    <Window.Resources>
        <local:FixWidth x:Key="fixWidth"/>
        
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4">
                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D5AFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="mediaNameList_MouseDown"/>
            <EventSetter Event="MouseDoubleClick" Handler="mediaNameList_MouseDoubleClick"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Playlists -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="PLAYLISTS" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#888888" Margin="5,0,10,0"/>
                <Button Style="{StaticResource ToolbarButton}" x:Name="pathCopy" Command="{Binding CopyPlaylistCommand}" ToolTip="New Playlist from Current">
                    <Image Source="/Images/outline_file_copy_white_48dp.png" Opacity="0.8"/>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" x:Name="nameDelete" Command="{Binding DeletePlaylistCommand}" CommandParameter="{Binding SelectedItem, ElementName=mediaNameList}" ToolTip="Delete Selected Playlist">
                    <Image Source="/Images/delete-outline.png" Opacity="0.8"/>
                </Button>
            </StackPanel>

            <ListView x:Name="mediaNameList" Grid.Row="1" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" SizeChanged="ListView_SizeChanged" AllowDrop="True" Drop="mediaNameList_Drop" DragOver="ListView_DragOver">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseMove" Handler="ListViewItem_MouseMove"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="{Binding ActualWidth, ElementName=mediaNameList, Converter={StaticResource fixWidth}}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding name}" MouseDown="TextBlock_MouseDown" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding name}" Visibility="Collapsed" LostFocus="txtbox_LostFocus" KeyDown="TextBox_KeyDown" Background="#333333" Foreground="White" BorderThickness="1" BorderBrush="#3D5AFE"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="4" Background="Transparent" Margin="4,0"/>

        <!-- Right Panel: Files -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MEDIA FILES" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#888888" Margin="5,0,10,0"/>
                    <Button Style="{StaticResource ToolbarButton}" x:Name="pathDelete" Command="{Binding DeleteMediaDataCommand}" CommandParameter="{Binding SelectedItems, ElementName=mediaPathList}" ToolTip="Remove Selected Files">
                        <Image Source="/Images/delete-outline.png" Opacity="0.8"/>
                    </Button>
                </StackPanel>

                <TextBox x:Name="searchBox" Grid.Column="1" Width="200" Padding="8,4" Background="#252525" Foreground="White" BorderThickness="1" BorderBrush="#333333" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="Search files..."/>
            </Grid>

            <ListView x:Name="mediaPathList" Grid.Row="1" ItemsSource="{Binding FilteredMediaData}" AlternationCount="2" SizeChanged="ListView_SizeChanged" SelectionMode="Extended" AllowDrop="True" Drop="mediaPathList_Drop" DragOver="ListView_DragOver">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseMove" Handler="ListViewItem_MouseMove"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Path" DisplayMemberBinding="{Binding path}" Width="{Binding ActualWidth, ElementName=mediaPathList, Converter={StaticResource fixWidth}}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
