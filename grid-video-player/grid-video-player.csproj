<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>GridPlayer</RootNamespace>
		<UseWPF>true</UseWPF>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<EnableMsixTooling>true</EnableMsixTooling>
		<SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
		<NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604</NoWarn>
		<AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<IncludeNativeLibrariesForSelfContained>true</IncludeNativeLibrariesForSelfContained>
	</PropertyGroup>

	<Target Name="FinalCleanup" AfterTargets="Build;Publish" Condition="'$(Configuration)'=='Release'">
		<Exec Command="powershell -Command &quot;$dirs = @('$(TargetDir)', '$(PublishDir)'); foreach ($d in $dirs) { if ($d -and (Test-Path $d)) { $r = Join-Path $d 'runtimes'; if (Test-Path $r) { Get-ChildItem $r | Where-Object { $_.Name -ne 'win-x64' } | Remove-Item -Recurse -Force }; Get-ChildItem $d -Filter *.pdb | Remove-Item -Force } }&quot;" IgnoreExitCode="true" />
	</Target>

	<ItemGroup>
		<None Remove="Images\delete-outline.png" />
		<None Remove="Images\outline_file_copy_white_48dp.png" />
		<None Remove="Images\outline_list_alt_white_48dp.png" />
		<None Remove="Images\outline_volume_off_white_48dp.png" />
		<None Remove="Images\outline_volume_up_white_48dp.png" />
		<None Remove="Images\pause-circle-outline.png" />
		<None Remove="Images\play-circle-outline.png" />
		<None Remove="Images\stop-circle-outline.png" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Images\delete-outline.png" />
		<Resource Include="Images\outline_file_copy_white_48dp.png" />
		<Resource Include="Images\outline_list_alt_white_48dp.png" />
		<Resource Include="Images\outline_volume_off_white_48dp.png" />
		<Resource Include="Images\outline_volume_up_white_48dp.png" />
		<Resource Include="Images\pause-circle-outline.png" />
		<Resource Include="Images\play-circle-outline.png" />
		<Resource Include="Images\stop-circle-outline.png" />
	</ItemGroup>

	<Target Name="CopyFFmpeg" AfterTargets="AfterBuild">
		<ItemGroup>
			<FFmpegFiles Include="$(PkgFFmpeg_Native)\runtimes\win7-x64\native\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(FFmpegFiles)" DestinationFolder="$(TargetDir)ffmpeg\" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<Content Include="$(PkgFFmpeg_Native)\runtimes\win7-x64\native\*.*"
				 Link="ffmpeg\%(Filename)%(Extension)"
				 CopyToOutputDirectory="PreserveNewest"
				 CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="AnimatedImage.Native" Version="2.1.2" />
	  <PackageReference Include="AnimatedImage.Wpf" Version="2.1.4" />
	  <PackageReference Include="FFME.Windows" Version="4.4.350" />
	  <PackageReference Include="FFmpeg.Native" Version="4.4.0.2386" GeneratePathProperty="true" />
	  <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
	  <PackageReference Include="SkiaSharp" Version="3.119.2" />
	  <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
	</ItemGroup>


</Project>
